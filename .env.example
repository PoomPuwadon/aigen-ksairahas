# Copy this file to .env and fill in your own Supabase project's values.
# Both are found in your Supabase project: Settings -> API.
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe to expose in a
# frontend bundle. It is NOT the service_role key. Never put the
# service_role key here or anywhere in this project's source; it belongs
# only in the Google Apps Script's Script Properties (see
# google-apps-script/README.md).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
